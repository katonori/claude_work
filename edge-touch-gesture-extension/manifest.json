{
  "manifest_version": 3,
  "name": "タッチジェスチャー: L字/↑→/↑←でタブ操作",
  "version": "3.0.0",
  "description": "Edge for Android で、1本指の軌跡ジェスチャーでタブを操作します。L字でタブを閉じる、↑→で次のタブへ、↑←で前のタブへ切り替えます。",
  "permissions": ["tabs", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "タッチジェスチャー設定"
  }
}
