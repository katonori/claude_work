{
  "manifest_version": 3,
  "name": "タッチジェスチャー: 3本指スワイプでタブを閉じる",
  "version": "1.0.0",
  "description": "Edge for Android で、3本指の上下スワイプによりアクティブなタブを閉じるタッチジェスチャーを追加します。",
  "permissions": ["tabs", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "タッチジェスチャー設定"
  }
}
