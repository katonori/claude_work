+++ b/src/c/ui/theme_layer.h
@@ -0,0 +1,23 @@
+/**
+ * Theme layer
+ *
+ * Full-screen overlay added on top of every other layer. In the light theme it
+ * inverts the grayscale pixels (white <-> black, light <-> dark gray) of the
+ * rendered frame, so the whole watchface turns into black-on-white while
+ * colored graph fills keep their color. In the dark theme it does nothing.
+ *
+ * @author    Cory Hughart <cory@coryhughart.com>
+ * @copyright 2026 Cory Hughart
+ * @license   https://www.gnu.org/licenses/gpl-3.0.html GPL-3.0-or-later
+ * @link      https://cr0ybot.com/project/pebble-watchface-carbon
+ */
+
+#pragma once
+#include <pebble.h>
+
+typedef struct ThemeLayer ThemeLayer;
+
+ThemeLayer *theme_layer_create(GRect frame);
+void theme_layer_destroy(ThemeLayer *layer);
+Layer *theme_layer_get_layer(ThemeLayer *layer);
+void theme_layer_set_light(ThemeLayer *layer, bool light);
