diff --git a/src/c/ui/theme_layer.c b/src/c/ui/theme_layer.c
new file mode 100644
index 0000000..d749eb8
--- /dev/null
+++ b/src/c/ui/theme_layer.c
@@ -0,0 +1,91 @@
+/**
+ * Theme layer
+ *
+ * @author    Cory Hughart <cory@coryhughart.com>
+ * @copyright 2026 Cory Hughart
+ * @license   https://www.gnu.org/licenses/gpl-3.0.html GPL-3.0-or-later
+ * @link      https://cr0ybot.com/project/pebble-watchface-carbon
+ */
+
+#include "theme_layer.h"
+#include <stdlib.h>
+
+struct ThemeLayer {
+	Layer *layer;
+	bool light;
+};
+
+// Invert the grayscale pixels of the layer's area in the frame buffer. Pebble
+// re-renders the whole layer tree for every redraw, so this runs on a freshly
+// drawn frame each time and never double-inverts.
+static void prv_update_proc(Layer *layer, GContext *ctx) {
+	ThemeLayer *tl = *(ThemeLayer **)layer_get_data(layer);
+	if (!tl->light)
+		return;
+
+	GRect bounds = layer_get_bounds(layer);
+	GPoint origin = layer_convert_point_to_screen(layer, GPointZero);
+	GBitmap *fb = graphics_capture_frame_buffer(ctx);
+	if (!fb)
+		return;
+	GBitmapFormat fmt = gbitmap_get_format(fb);
+
+	for (int y = 0; y < bounds.size.h; y++) {
+		GBitmapDataRowInfo row = gbitmap_get_data_row_info(fb, origin.y + y);
+		int x0 = origin.x > row.min_x ? origin.x : row.min_x;
+		int x1 = origin.x + bounds.size.w - 1;
+		if (x1 > row.max_x)
+			x1 = row.max_x;
+		if (x0 > x1)
+			continue;
+
+		if (fmt == GBitmapFormat1Bit) {
+			// 1 bit per pixel, LSB first: flip whole bytes (rows are
+			// byte-aligned and this layer covers the full width).
+			for (int b = x0 / 8; b <= x1 / 8; b++)
+				row.data[b] ^= 0xFF;
+		} else {
+			// 8-bit ARGB2222. Only gray pixels (r == g == b) are inverted;
+			// colored pixels are left alone.
+			for (int x = x0; x <= x1; x++) {
+				uint8_t px = row.data[x];
+				uint8_t r = (px >> 4) & 3;
+				if (r == ((px >> 2) & 3) && r == (px & 3)) {
+					uint8_t inv = 3 - r;
+					row.data[x] = (px & 0xC0) | (inv << 4) | (inv << 2) | inv;
+				}
+			}
+		}
+	}
+
+	graphics_release_frame_buffer(ctx, fb);
+}
+
+ThemeLayer *theme_layer_create(GRect frame) {
+	ThemeLayer *tl = malloc(sizeof(ThemeLayer));
+	if (!tl)
+		return NULL;
+	tl->light = false;
+	tl->layer = layer_create_with_data(frame, sizeof(ThemeLayer *));
+	*(ThemeLayer **)layer_get_data(tl->layer) = tl;
+	layer_set_update_proc(tl->layer, prv_update_proc);
+	return tl;
+}
+
+void theme_layer_destroy(ThemeLayer *layer) {
+	if (!layer)
+		return;
+	layer_destroy(layer->layer);
+	free(layer);
+}
+
+Layer *theme_layer_get_layer(ThemeLayer *layer) {
+	return layer ? layer->layer : NULL;
+}
+
+void theme_layer_set_light(ThemeLayer *layer, bool light) {
+	if (!layer)
+		return;
+	layer->light = light;
+	layer_mark_dirty(layer->layer);
+}
