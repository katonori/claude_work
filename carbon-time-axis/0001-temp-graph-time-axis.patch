-					{ 'label': 'Monday, 1/15', 'value': '%A, %m/%d' },
-					{ 'label': 'Monday, 15/1', 'value': '%A, %d/%m' },
-					{ 'label': 'Monday, Jan 15', 'value': '%A, %b %d' },
