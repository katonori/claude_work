+					{ 'label': 'Mon, Jan 15', 'value': '%a, %b %d' },
 					{ 'label': '1/15/2026', 'value': '%m/%d/%Y' },
 					{ 'label': '15/1/2026', 'value': '%d/%m/%Y' },
 					{ 'label': '15 Jan 2026', 'value': '%d %b %Y' },
