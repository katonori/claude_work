+++ b/src/pkjs/config.js
@@ -65,11 +65,11 @@ module.exports = [
 				'type': 'select',
 				'messageKey': 'SETTING_DATE_FORMAT',
 				'label': 'Date Format',
-				'defaultValue': '%A, %m/%d',
